[Unit]
Description=YouTube shadowing-sentence mining API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/jp_sentence_splits/server/youtube-mining
Environment=MINING_YTDLP_COOKIES_FILE=%h/projects/jp_sentence_splits/server/youtube-mining/youtube-cookies.txt
# Route YouTube downloads through a home-connection device on the tailnet —
# this box's datacenter IP is bot-blocked. Primary = laptop, fallback =
# phone (used when the laptop is asleep). Needs `sudo tailscale set
# --operator=<user>` run once by an admin. See app/exit_node.py + the
# deploy README. Clear these to fall back to cookie-only auth.
# Durable source-audio mirror in Supabase Storage. The file (chmod 600, owned
# by the user, never read by tooling) holds SUPABASE_URL=... and
# SUPABASE_SERVICE_ROLE_KEY=...; absent file = backup disabled.
EnvironmentFile=-%h/.config/youtube-mining/supabase.env
# Phone notifications (ntfy) when a mining job is ready or an assistant run
# finishes/fails. The file (chmod 600) holds MINING_NTFY_URL=https://ntfy.sh/<secret-topic>
# and optionally MINING_NTFY_CLICK_BASE_URL=<app origin>; absent = disabled.
EnvironmentFile=-%h/.config/youtube-mining/ntfy.env
Environment=MINING_EXIT_NODE=eds-macbook-pro
Environment=MINING_EXIT_NODE_FALLBACK=iphone174
# yt-dlp's JS challenge solver needs a node >= 22 binary; the systemd
# user PATH doesn't include nvm's. Point at a stable symlink the user
# maintains: ln -sfn "$(nvm which default)" ~/.local/bin/node
Environment=MINING_YTDLP_JS_RUNTIME_PATH=%h/.local/bin/node
# Source ASR on a small (4-core) analysis box can take longer than the
# 1800s default for a 30-min+ video; a timeout silently falls back to
# punctuation-free auto-captions. Pair with ANALYSIS_SOURCE_WORD_TIMESTAMPS=0
# on shadowing-analysis-api (that's the real speedup — its word-timestamp
# DTW pass is single-threaded Python).
Environment=MINING_ASR_TIMEOUT_SECONDS=3600
# Keep job scratch dirs + stage checkpoints off /tmp so a resume survives a
# reboot (checkpoints let a job started on one device be finished on
# another — see app/jobs.py `_write_checkpoint`). Same tree as the source
# cache. Swept on the idle / hard TTL regardless.
Environment=MINING_JOBS_ROOT=%h/.cache/youtube-mining/jobs
# "Send to assistant" (POST /assist) shells out to these CLIs; codex is an
# nvm-installed node script, so give its full path (app/assist.py also puts the
# binary's own dir on PATH for the node shebang).
Environment=MINING_CODEX_PATH=%h/.nvm/versions/node/v24.19.0/bin/codex
Environment=MINING_CLAUDE_PATH=%h/.local/bin/claude
# Per-backend limit for one assistant call. 25 book walkthroughs take Codex
# 6-11 min, so the 600s default cut some off; a hung backend is caught earlier
# by the 90s health probe, not by this.
Environment=MINING_ASSIST_TIMEOUT_SECONDS=1200
# Assistant CLI calls allowed at once across all runs (each is a node process;
# the box has 8 GB). Quick import's "Agents" selector is clamped to this.
Environment=MINING_ASSIST_MAX_CONCURRENCY=3
ExecStart=%h/projects/jp_sentence_splits/server/youtube-mining/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
