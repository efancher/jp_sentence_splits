{
  "name": "satori-glossbook",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "VITE_DEPLOY=1 tsc -b && VITE_DEPLOY=1 vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test",
    "ci": "npm run check && npm run build:pages",
    "import:wanikani-kanji": "tsx scripts/import-wanikani-kanji.ts",
    "jmdict:lookup": "tsx scripts/lookup-jmdict.ts",
    "import:anki-sentences": "tsx scripts/import-anki-sentences.ts",
    "backfill:vocabulary-suggestions": "tsx scripts/backfill-vocabulary-suggestions.ts",
    "backfill:vocabulary-meanings": "tsx scripts/backfill-vocabulary-meanings.ts",
    "backfill:vocabulary-suggestion-glosses": "tsx scripts/backfill-vocabulary-suggestion-glosses.ts",
    "backfill:confirmed-vocabulary-links": "tsx scripts/backfill-confirmed-vocabulary-links.ts",
    "backfill:verb-pair-confusions": "tsx scripts/backfill-verb-pair-confusions.ts",
    "fix:html-entity-meanings": "tsx scripts/fix-html-entity-meanings.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.110.8",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
