# Public Supabase client config (safe to expose in a static frontend).
# Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Node-side maintenance scripts only (scripts/), never read by the browser
# app. Scripts sign in as a real user via the anon client above (same RLS
# path as the browser), not a service-role key.
SCRIPT_SUPABASE_EMAIL=you@example.com
SCRIPT_SUPABASE_PASSWORD=your-account-password

# scripts/import-wanikani-kanji.ts — generate at
# https://www.wanikani.com/settings/personal_access_tokens
WANIKANI_API_TOKEN=your-wanikani-api-token
